# Delta app server. Install with deploy/install.sh.
# ponytail: Jetson paths/IP hardcoded (single known device); parameterize if a second host appears.
[Unit]
Description=Delta personal finance webapp
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=zeapsu
WorkingDirectory=/home/zeapsu/Projects/Delta
EnvironmentFile=/home/zeapsu/Projects/Delta/.env
# hermes on PATH for the chat bridge; nvm node for next
Environment=PATH=/home/zeapsu/.local/bin:/home/zeapsu/.nvm/versions/node/v25.9.0/bin:/usr/local/bin:/usr/bin:/bin
# Bind to the tailscale IP only — the tailnet is the trust boundary (closes the XFF spoofing ceiling in app/api/chat/route.ts)
ExecStart=/home/zeapsu/.nvm/versions/node/v25.9.0/bin/node node_modules/next/dist/bin/next start -H 100.116.56.85
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
