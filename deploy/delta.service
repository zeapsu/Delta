# Delta app server, without Docker. A template: deploy/install.sh fills in the
# @...@ values for this machine and installs it.
[Unit]
Description=Delta personal finance webapp
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env
Environment=PATH=@NODE_DIR@:/usr/local/bin:/usr/bin:/bin
# Bind to one private address only (the Tailscale IP by default). The network
# is the trust boundary: pages have no guard of their own, and the API guard
# trusts a client-supplied X-Forwarded-For (lib/tailnet.ts).
ExecStart=@NODE@ node_modules/next/dist/bin/next start -H @BIND@
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
