# Hermes gateway for the Delta chat bridge (#48). Install with deploy/install.sh.
# Port 9117: 9119 is the user's own hermes serve (0.0.0.0, OAuth-gated),
# 9118 its dashboard. NEVER `hermes serve --stop` in scripts — it stops
# ALL hermes web servers including the user's. Loopback bind is what
# enables ?token= auth (non-loopback flips hermes to its OAuth gate).
[Unit]
Description=Hermes serve gateway for Delta chat
After=network-online.target
Wants=network-online.target

[Service]
User=zeapsu
WorkingDirectory=/home/zeapsu/Projects/Delta/deploy/advisor-home
# shared .env: HERMES_DASHBOARD_SESSION_TOKEN is read natively by hermes serve
# and as the client token by /api/chat
EnvironmentFile=/home/zeapsu/Projects/Delta/.env
Environment=PATH=/home/zeapsu/.local/bin:/usr/local/bin:/usr/bin:/bin
# hermes is not on PATH under systemd — absolute path required.
# If serve ever attaches to the existing 9119 machine-level server instead of
# starting its own listener, add --isolated (see AGENTS.md).
ExecStart=/home/zeapsu/.local/bin/hermes serve --port 9117 --host 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
