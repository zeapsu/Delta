# Delta configuration. Copy to .env and fill in. Never commit .env.

# Plaid keys: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
PLAID_PRODUCTION_SECRET=
# sandbox (fake banks, user_good / pass_good) or production (real accounts,
# needs Plaid production access). Don't switch an existing DB between them.
PLAID_ENV=sandbox

# The URL agents and your browser use to reach Delta, e.g.
# http://100.x.y.z:3000 (your Tailscale IP). Printed in the MCP configs from
# `npm run token -- create`.
DELTA_URL=http://127.0.0.1:3000

# Networks allowed to call /api, comma-separated IPv4 CIDRs. Loopback is
# always allowed. Default: Tailscale's 100.64.0.0/10.
# DELTA_ALLOWED_NETWORKS=100.64.0.0/10

# --- Docker only ---
# Host interface to publish the port on. Set it to this machine's Tailscale
# IP (`tailscale ip -4`) to reach Delta from your tailnet devices.
DELTA_BIND=127.0.0.1
# DELTA_PORT=3000
# Linux + Tailscale: if API calls from your phone get refused ("Could not
# start Plaid Link"), run on the host network instead of publishing the port
# (docs/self-hosting.md, "Linux with Tailscale"):
# COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml
# SYNC_INTERVAL_HOURS=6
# BACKUP_INTERVAL_HOURS=24

# --- Bare metal only (Docker sets this to /data/delta.db) ---
# DATABASE_PATH=./delta.db
